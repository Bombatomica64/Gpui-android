From 8ee2ad7f6939e33fe2f703dfbcf6a1a1f9eb94ab Mon Sep 17 00:00:00 2001
From: lorenzomicheli <lorenzo.micheli@instal.com>
Date: Mon, 28 Sep 2026 16:58:00 +0000
Subject: [PATCH] gpui-mobile: build against gpui-pre 0.3.7 (GPUI Kit 0.7.0's
 snapshot)

gpui-pre-wgpu 0.3.7 returns Option<GpuSpecs> from WgpuRenderer::gpu_specs.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 gpui-mobile/Cargo.toml            | 8 ++++----
 gpui-mobile/src/android/window.rs | 2 +-
 gpui-mobile/src/ios/window.rs     | 2 +-
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/gpui-mobile/Cargo.toml b/gpui-mobile/Cargo.toml
index af6cd6a..0cdadbe 100644
--- a/gpui-mobile/Cargo.toml
+++ b/gpui-mobile/Cargo.toml
@@ -63,7 +63,7 @@ futures      = "0.3"
 raw-window-handle = "0.6"
 
 # ── GPUI core crate (provides Platform trait, event types, geometry, etc.) ───
-gpui = { package = "gpui-pre", version = "=0.3.6", default-features = false }
+gpui = { package = "gpui-pre", version = "=0.3.7", default-features = false }
 
 # ── iOS ──────────────────────────────────────────────────────────────────────
 
@@ -80,7 +80,7 @@ uuid                = { version = "1", features = ["v4", "v5"] }
 block2              = "0.6"
 
 # wgpu renderer (Metal backend on iOS/Android)
-gpui_wgpu = { package = "gpui-pre-wgpu", version = "=0.3.6", features = ["font-kit"] }
+gpui_wgpu = { package = "gpui-pre-wgpu", version = "=0.3.7", features = ["font-kit"] }
 wgpu = "29.0.4"
 
 # Text / font stack
@@ -111,7 +111,7 @@ android_logger = "0.15"
 
 # wgpu renderer (Vulkan backend on Android)
 # Android uses Cosmic Text and system fonts; font-kit pulls in desktop Fontconfig.
-gpui_wgpu = { package = "gpui-pre-wgpu", version = "=0.3.6" }
+gpui_wgpu = { package = "gpui-pre-wgpu", version = "=0.3.7" }
 
 # rustc-hash is required by the PlatformKeyboardMapper trait signature
 rustc-hash = "2"
@@ -120,7 +120,7 @@ uuid       = { version = "1", features = ["v5"] }
 # ── dev ──────────────────────────────────────────────────────────────────────
 
 [dev-dependencies]
-gpui = { package = "gpui-pre", version = "=0.3.6", default-features = false, features = ["test-support"] }
+gpui = { package = "gpui-pre", version = "=0.3.7", default-features = false, features = ["test-support"] }
 
 # ── profiles ─────────────────────────────────────────────────────────────────
 
diff --git a/gpui-mobile/src/android/window.rs b/gpui-mobile/src/android/window.rs
index efd697a..765dc1d 100644
--- a/gpui-mobile/src/android/window.rs
+++ b/gpui-mobile/src/android/window.rs
@@ -1032,7 +1032,7 @@ impl AndroidWindow {
     /// Returns GPU specs from the renderer, if available.
     pub fn gpu_specs(&self) -> Option<GpuSpecs> {
         let state = self.state.lock();
-        state.renderer.as_ref().map(|r| r.gpu_specs())
+        state.renderer.as_ref().and_then(|r| r.gpu_specs())
     }
 
     /// Whether the window is currently active / visible.
diff --git a/gpui-mobile/src/ios/window.rs b/gpui-mobile/src/ios/window.rs
index 709d659..2d9c709 100644
--- a/gpui-mobile/src/ios/window.rs
+++ b/gpui-mobile/src/ios/window.rs
@@ -1593,7 +1593,7 @@ impl PlatformWindow for IosWindow {
 
     fn gpu_specs(&self) -> Option<GpuSpecs> {
         let guard = self.renderer.lock();
-        guard.as_ref().map(|r| r.gpu_specs())
+        guard.as_ref().and_then(|r| r.gpu_specs())
     }
 
     fn update_ime_position(&self, _bounds: Bounds<Pixels>) {
-- 
2.43.0

